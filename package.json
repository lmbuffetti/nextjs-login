{
  "name": "nextjs-login",
  "author": "Luigi Mattia Buffetti",
  "repository": "https://github.com/vercel/examples.git",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dependencies:fix": "syncpack fix-mismatches",
    "dependencies:lint": "syncpack lint-mismatches",
    "dependencies:update": "syncpack update",
    "pre-commit": "eslint ./src && tsc",
    "dev": "next dev",
    "dev-turbo": "turbo run dev",
    "build": "turbo builds",
    "builds": "pnpm test-dom && next build",
    "start": "next start",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx --fix && tsc",
    "lint-turbo": "turbo run lint",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint-turbo:fix": "turbo run lint:fix",
    "test-dom": "NODE_ENV=test jest ./src/__tests__ --config ./jest.config.dom.ts",
    "test-node": "NODE_ENV=test jest ./src/__tests__ --config ./jest.config.node.ts --detectOpenHandles --forceExit",
    "cypress:open": "cypress open",
    "run-test": "cypress run",
    "e2e": "cypress run --e2e --headless --browser chrome",
    "test-cypress": "next start & npm run e2e",
    "create-doc": "swagger-cli bundle src/api/Swagger/index.yaml --outfile src/api/Swagger/index.json",
    "vercel-build": "pnpm build"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@typegoose/typegoose": "13.5.0",
    "@types/bcrypt": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/mocha": "10.0.10",
    "@types/ms": "2.1.0",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/swagger-ui-react": "5.18.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.9.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "18.0.10",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-formatjs": "8.1.4",
    "eslint-plugin-jsdoc": "65.5.4",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "formatjs": "0.1.1",
    "isomorphic-fetch": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mongoose": "~9.9.5",
    "ms": "2.1.3",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "nextjs-toploader": "^3.9.17",
    "node-mocks-http": "1.18.1",
    "pre-commit": "2.0.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.1",
    "react-hot-toast": "2.6.1",
    "react-image-crop": "11.1.2",
    "react-select": "5.10.2",
    "swagger-cli": "4.0.4",
    "swagger-ui-react": "5.36.0",
    "swr": "2.5.1",
    "syncpack": "15.3.4",
    "ts-node": "latest",
    "turbo": "2.11.13"
  },
  "devDependencies": {
    "@cypress/code-coverage": "4.1.3",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.7",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "autoprefixer": "10.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "cypress": "16.3.0",
    "cypress-image-diff-js": "2.8.0",
    "eslint": "9.39.5",
    "eslint-plugin-cypress": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-testing-library": "^7.16.3",
    "globals": "^17.14.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "ts-node": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "cypress",
      "esbuild"
    ]
  }
}
